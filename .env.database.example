# Lumens — administração local do PostgreSQL
#
# Copie para `.env.database` e preencha:  cp .env.database.example .env.database
# O backend NÃO carrega este arquivo. Ele é exclusivo de Docker, provisionamento,
# migrações e testes de integração. Nunca use credenciais de produção aqui.

POSTGRES_USER=lumens
POSTGRES_PASSWORD=lumens_local
POSTGRES_DB=lumens
POSTGRES_PORT=5432

# Senha do login restrito criado por `pnpm db:provision`.
POSTGRES_APP_PASSWORD=lumens_app_local

# Owner/migrador: cria objetos e aplica migrações, mas não é usado pelo backend.
DATABASE_URL_MIGRACAO=postgresql://lumens:lumens_local@localhost:5432/lumens

# Administrador SUPERUSER do cluster descartável de teste: a suíte cria bases e papéis temporários.
# Nunca aponte esta URL para produção; CREATEDB sozinho não cobre os cenários de endurecimento.
DATABASE_URL_TESTE=postgresql://lumens:lumens_local@localhost:5432/lumens_test
