# Lumens — variáveis de ambiente (SCRUM-75)
#
# Copie para `.env` e preencha:  cp .env.example .env
# O `.env` é ignorado pelo git e NUNCA deve ser commitado. Este arquivo aqui só tem
# valores de desenvolvimento local e marcadores — nenhum segredo real.
#
# Em produção, os segredos vivem no cofre da hospedagem e no CI, não em arquivo
# (Roteiro da Parte 1, seção 6 "Segredos").


# ---------------------------------------------------------------------------
# Banco local (docker-compose.yml)
# ---------------------------------------------------------------------------
# Credenciais do container. São de desenvolvimento local, não são segredo: o
# docker-compose.yml publica a porta em 127.0.0.1, então o banco não é alcançável
# por outras máquinas da rede, e não há dado real nele.

POSTGRES_USER=lumens
POSTGRES_PASSWORD=lumens_local
POSTGRES_DB=lumens

# Porta no SEU computador. Mude se a 5432 já estiver ocupada por outro Postgres.
POSTGRES_PORT=5432


# ---------------------------------------------------------------------------
# Conexões da aplicação
# ---------------------------------------------------------------------------
# Usuário da aplicação: é quem grava. Precisa bater com as credenciais acima.
DATABASE_URL=postgresql://lumens:lumens_local@localhost:5432/lumens

# Usuário SÓ DE LEITURA, usado pelo site. Ele enxerga apenas as views públicas,
# que já vêm sem identidade — é assim que a RNF01 é garantida mesmo se o código
# do site tiver um bug. O usuário real é criado na T14 (SCRUM-87); até lá esta
# variável aponta para o mesmo banco.
DATABASE_URL_LEITURA=postgresql://lumens:lumens_local@localhost:5432/lumens

# Banco usado pelos testes de integração. Criado por docker/init/.
DATABASE_URL_TESTE=postgresql://lumens:lumens_local@localhost:5432/lumens_test


# ---------------------------------------------------------------------------
# Chaves de criptografia (T17 / SCRUM-90)
# ---------------------------------------------------------------------------
# ATENÇÃO: são DUAS chaves DIFERENTES. Não repita o mesmo valor nas duas.
#   - CHAVE_CIFRA cifra telefone e e-mail (AES-256-GCM).
#   - CHAVE_HMAC gera o HMAC-SHA256 que permite BUSCAR pelo telefone sem decifrar
#     a base inteira.
# Usar o mesmo valor nas duas elimina a separação entre cifrar e buscar, e nada
# no sistema avisa — por isso a validação do back-end recusa chaves iguais.
#
# Gerar cada uma (32 bytes em base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

CHAVE_CIFRA=cole-aqui-32-bytes-em-base64
CHAVE_HMAC=cole-aqui-OUTROS-32-bytes-em-base64


# ---------------------------------------------------------------------------
# WhatsApp / Meta (parte 2)
# ---------------------------------------------------------------------------
# Do app da Meta. Em desenvolvimento, use o número de teste (RNF06).

META_TOKEN=cole-aqui-o-token-de-acesso
META_APP_SECRET=cole-aqui-o-app-secret
# Você inventa este valor e repete no painel da Meta ao configurar o webhook.
META_VERIFY_TOKEN=escolha-uma-frase-qualquer
META_PHONE_NUMBER_ID=cole-aqui-o-id-do-numero


# ---------------------------------------------------------------------------
# E-mail (código de verificação do estudante)
# ---------------------------------------------------------------------------
# Serviço SMTP em plano gratuito (RNF12 — custo).

EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_USUARIO=cole-aqui-o-usuario
EMAIL_SENHA=cole-aqui-a-senha
EMAIL_REMETENTE=lumens@exemplo.com


# ---------------------------------------------------------------------------
# AWS / fotos (T20 — SCRUM-93)
# ---------------------------------------------------------------------------
# Em produção as credenciais vêm do papel IAM, não daqui.

AWS_REGION=us-east-1
S3_BUCKET_FOTOS=lumens-fotos

# Só para uso local, apontando para um emulador de S3. Deixe vazio para usar a AWS
# de verdade. O emulador ainda não faz parte do docker-compose (entra junto com a
# parte de fotos).
S3_ENDPOINT=
