{
  "name": "@lumens/db",
  "version": "0.0.0",
  "private": true,
  "description": "Esquema, migrações, views e seed do PostgreSQL (parte 1).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file-if-exists=../../.env ../../node_modules/vitest/vitest.mjs run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
